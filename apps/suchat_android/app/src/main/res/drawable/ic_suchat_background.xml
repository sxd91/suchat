<?xml version="1.0" encoding="utf-8"?>
<!--
  Suchat 图标背景 —— 矢量渐变（不是位图，任何密度下都锐利）。

  颜色取自品牌色的深浅两端，形成轻微斜向渐变：
  - 起点 #2F7CF6（蓝）
  - 终点 #7C4DFF（紫）

  说明：这是**自适应图标的背景层**，只在常规（非主题图标）模式下可见；
  开启莫奈主题图标时，系统会忽略 background/foreground，改用 monochrome 重绘。

  注意：aapt 命名空间必须声明在**根元素**上（写在 <aapt:attr> 里编译不过）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF2F7CF6" />
                <item android:offset="1" android:color="#FF7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>